# Copia este archivo a ".env" (en la raíz del proyecto) y rellena tus llaves. Nunca lo subas a Git.
ENV=development
GROQ_API_KEY=
# Obligatorio en producción (32+ caracteres aleatorios): seudonimiza IPs y usuarios en los logs.
IP_HASH_SALT=
# Demo pública (GitHub Pages + Render): crea este negocio al arrancar si el disco es efímero
# y lo perdió entre reinicios. Vacío = apagado. Ver render.yaml.
SEED_DEMO_TENANT=

# Orígenes del navegador permitidos, separados por comas. Sin comodines; https:// en producción.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# IP o redes de tu proxy. Vacío: se ignora X-Forwarded-For.
TRUSTED_PROXIES=

# WhatsApp Cloud API (Meta). Apagado si falta cualquiera de las tres; a medio configurar, la app no arranca.
# Después de configurarlas: python -m app.cli link-whatsapp --tenant SLUG --phone-number-id ID
WHATSAPP_APP_SECRET=
# 24 caracteres o más, aleatorio; es el que se escribe en el panel de Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_MAX_AGE_SECONDS=3600

# Depósitos con Stripe Checkout. Apagado si faltan las dos llaves; a medio configurar, la app no arranca.
# En desarrollo solo se aceptan llaves de prueba (sk_test_...). Webhook: /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública del sitio (a donde Stripe devuelve al cliente). https:// en producción.
PUBLIC_SITE_URL=
BOOKING_HOLD_MINUTES=35
BOOKING_LEAD_MINUTES=60
BOOKING_DAYS_AHEAD=60

# Correo para reactivación (CASL). Apagado sin SMTP_HOST y SMTP_FROM; siempre con TLS (STARTTLS o puerto 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CAMPAIGN_MAX_RECIPIENTS=500

# Google Calendar es opcional. Requiere secrets/credentials.json.
CALENDAR_ENABLED=false

# Límites (valores por defecto)
CHAT_RATE=10/minute;100/day
# Lectura pública (servicios, horarios, estado de una reserva)
BROWSE_RATE=60/minute;1000/day
LOGIN_RATE=5/minute
ADMIN_RATE=60/minute
# Para compartir contadores entre procesos: redis://host:6379 (requiere instalar el paquete redis)
RATE_LIMIT_STORAGE=memory://
SESSION_TTL_MINUTES=30
MAX_BODY_BYTES=65536
LLM_MAX_OUTPUT_TOKENS=500
LLM_DAILY_TOKENS_PER_IP=20000
LLM_DAILY_TOKENS_GLOBAL=200000
LLM_DAILY_TOKENS_PER_TENANT=100000
CONTACT_RATE=5/minute;20/day
CHAT_MAX_MESSAGES=60
CONVERSATION_RETENTION_DAYS=90
ALERT_THRESHOLD=20
