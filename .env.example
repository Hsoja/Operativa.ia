# Copia este archivo a ".env" (en la raíz del proyecto) y rellena tus llaves. Nunca lo subas a Git.
ENV=development
GROQ_API_KEY=

# Orígenes del navegador permitidos, separados por comas. Sin comodines; https:// en producción.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# IP o redes de tu proxy. Vacío: se ignora X-Forwarded-For.
TRUSTED_PROXIES=

# Google Calendar es opcional. Requiere secrets/credentials.json.
CALENDAR_ENABLED=false

# Límites (valores por defecto)
CHAT_RATE=10/minute;100/day
LOGIN_RATE=5/minute
ADMIN_RATE=60/minute
# Para compartir contadores entre procesos: redis://host:6379 (requiere instalar el paquete redis)
RATE_LIMIT_STORAGE=memory://
SESSION_TTL_MINUTES=30
MAX_BODY_BYTES=65536
LLM_MAX_OUTPUT_TOKENS=500
LLM_DAILY_TOKENS_PER_IP=20000
LLM_DAILY_TOKENS_GLOBAL=200000
ALERT_THRESHOLD=20
